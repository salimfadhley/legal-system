# goldberg MCP server (M14, ADR 0010). Built + run on Halob:
#   docker build -f Dockerfile.mcp -t goldberg-mcp .
#   docker run -d --name goldberg-mcp --restart=always --network host \
#     -e GOLDBERG_ES_URL=http://localhost:9200 goldberg-mcp
# Read-only: reaches Elasticsearch only (no Docling/OpenAI/Papra needed).
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1
ENV GOLDBERG_MCP_HOST=0.0.0.0
ENV GOLDBERG_MCP_PORT=8765

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir ".[mcp]"

EXPOSE 8765
# The /mcp endpoint rejects non-MCP requests (406 by design), so health-check by
# confirming the port is listening rather than by an HTTP status.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import socket,sys; socket.create_connection(('localhost',8765),3).close()" || exit 1

CMD ["goldberg", "mcp-serve"]
