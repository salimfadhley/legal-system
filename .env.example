# Goldberg processing stack — environment template (ADR 0012).
#
# Copy to `.env` (which is gitignored) and fill in the values for THIS host:
#   cp .env.example .env
# Every host-specific / secret value lives here and nowhere else — moving the stack to
# a new host means editing this file only (NFR-004). NO real secrets belong in the
# committed .env.example — placeholders only (NFR-002).

# ── Shared infrastructure (EXTERNAL — never part of this stack) ────────────────
# Elasticsearch and NATS are the shared "everything uses them" services. They are
# stateful and used by every current and future component, so they stay put (on Halob)
# while THIS processing stack is the portable piece that can move to a faster host.
# The stack connects to them over TCP; moving the stack never means moving ES or NATS.

# Elasticsearch — the corpus/wiki/events store. Point at the ALREADY-RUNNING instance
# (FR-002 / C-002); the stack never starts or replicates one.
#   - on Halob today:            http://192.168.86.31:9200
#   - on a new host:             wherever ES already runs / is reachable
GOLDBERG_ES_URL=http://192.168.86.31:9200

# NATS — the shared message bus (durability/eventing, ADR 0005; not yet actively used by
# the direct-index path). Also external and shared, like ES. Uncomment when a component
# starts using it; keep it pointed at the shared instance, not one inside this stack.
#NATS_URL=nats://192.168.86.31:4222

# ── Docling OCR (in-stack, addressed by compose service name) ──────────────────
# How the reconciler and mcp reach Docling. Leave as the compose service name so the
# stack is portable (FR-004). Only change if you run Docling outside the stack.
GOLDBERG_DOCLING_URL=http://docling:5001
# Host port to publish Docling on (container port is always 5001).
DOCLING_PORT=5001
# Memory cap for the Docling container on a petite host (NFR-003). A large scan that
# exceeds this OOMs the container and is dead-lettered + retried, not the whole host.
DOCLING_MEM_LIMIT=4g

# ── Enrichment (OpenAI) ────────────────────────────────────────────────────────
# Used by the enricher and by the doctor's enricher probe. Optional: text/passthrough
# documents ingest without it; leave blank to run without enrichment (doctor will then
# report the enricher DEGRADED rather than UP). NEVER commit a real key.
OPENAI_API_KEY=sk-REPLACE_ME

# ── Reconciler tuning (conservative, petite-host-friendly defaults) ────────────
RECONCILE_INTERVAL=300   # seconds between reconcile cycles
RECONCILE_WORKERS=2      # parallel extract/enrich workers
RECONCILE_BATCH=50       # max new files processed per cycle
RECONCILE_HEALTH_PORT=8098  # host port mapped to the reconciler's :8080 /health

# ── MCP server ─────────────────────────────────────────────────────────────────
GOLDBERG_MCP_HOST=0.0.0.0   # bind inside the container (0.0.0.0 = all interfaces)
GOLDBERG_MCP_PORT=8765      # served + published port

# ── Volumes (host paths) ───────────────────────────────────────────────────────
# goldberg-raw: the git working-tree ROOT of the raw corpus. Mounted read-only into the
# reconciler. MUST include .git — the reconciler runs `git log` for raw_commit provenance.
GOLDBERG_RAW_PATH=/Volumes/Home/work/project_goldberg/goldberg-raw
# Config dir: mounted READ-WRITE at /app/config. It must contain:
#   - projects.yaml            container-tuned (projects.raw.path=/data/goldberg-raw,
#                              projects.system.path=/app)
#   - provenance-manifest.json the reconciler WRITES this; a writable + persistent
#                              volume keeps registrations across restarts and makes the
#                              manifest (with goldberg-raw) the portable source of truth.
GOLDBERG_MANIFEST_PATH=/Volumes/Home/work/project_goldberg/goldberg-system/config
