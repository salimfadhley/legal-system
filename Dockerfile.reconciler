# Auto-ingestion reconciler (ADR 0011 / M15) — the canonical always-on ingest path.
# Build on Halob:
#   docker build -f Dockerfile.reconciler -t goldberg-reconciler .
# Run (see doc/runbooks/auto-ingestion-reconciler.md for the full recipe):
#   docker run -d --name goldberg-reconciler \
#     -e GOLDBERG_ES_URL=http://elasticsearch:9200 \
#     -e GOLDBERG_DOCLING_URL=http://docling:5001 \
#     -e OPENAI_API_KEY=sk-... \
#     -v /srv/goldberg-raw:/data/goldberg-raw:ro \
#     -v /srv/goldberg-system/config:/app/config \
#     -p 8080:8080 \
#     goldberg-reconciler \
#     goldberg watch --interval 300 --workers 2 --batch 50
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1

# git is needed for the manifest's raw_commit lookups over the goldberg-raw checkout.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir .

# Reconciler configuration (override at `docker run`):
#   GOLDBERG_ES_URL        Halob Elasticsearch (documents + pipeline events).
#   GOLDBERG_DOCLING_URL   how this container reaches docling-serve. Docling currently
#                          runs on the Mac; either tunnel it to Halob and point here,
#                          or run a Halob-local docling and use http://docling:5001.
#                          Text/passthrough (.md/.txt/.json/...) ingest without Docling.
#   OPENAI_API_KEY         enrichment.
#   Tuning is via the CLI flags: --interval / --workers / --batch.
ENV GOLDBERG_ES_URL=http://elasticsearch:9200 \
    GOLDBERG_DOCLING_URL=http://docling:5001

EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8080/health',timeout=4).status==200 else 1)"

# Default: poll forever with a conservative batch. Override the CMD to tune.
CMD ["goldberg", "watch", "--interval", "300", "--workers", "2", "--batch", "50"]
